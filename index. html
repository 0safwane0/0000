    function initSafGPT() {
        // تهيئة حدث الإدخال
        const chatInput = document.getElementById('chat-input');
        if (chatInput) {
            chatInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    sendMsg();
                }
            });
        }
    }

    async function sendMsg() {
        const chatInput = document.getElementById('chat-input');
        const chatBox = document.getElementById('chat-box');
        
        if (!chatInput || !chatBox) return;
        
        const val = chatInput.value.trim();
        if(!val) return;
        
        appendMsg(val, 'user');
        chatInput.value = '';
        const tid = appendMsg('جاري المعالجة...', 'ai', true);
        
        // محاكاة الرد (بدون API حقيقي)
        setTimeout(() => {
            const msgElement = document.getElementById(tid);
            if (msgElement) {
                msgElement.remove();
            }
            
            const responses = [
                "[Saf.GPT]: هذا سؤال ممتاز. يمكنني مساعدتك في فهم هذا المفهوم.",
                "[Saf.GPT]: أعتقد أنك تقصد " + val + ". دعني أشرح ذلك.",
                "[Saf.GPT]: بناءً على سؤالك، أنصحك بمراجعة مفهوم ذي صلة في الرادار.",
                "[Saf.GPT]: تحليل سؤالك يظهر تفكيراً استراتيجياً متقدماً."
            ];
            
            const randomResponse = responses[Math.floor(Math.random() * responses.length)];
            appendMsg(randomResponse, 'ai');
        }, 1000);
    }

    function appendMsg(txt, type, loading=false) {
        const chatBox = document.getElementById('chat-box');
        if (!chatBox) return null;
        
        const id = 'm'+Date.now();
        const d = document.createElement('div');
        d.id = id;
        d.className = `msg msg-${type}`;
        if(type === 'ai') d.innerHTML = `<span class="ai-label">Saf.GPT</span>${txt}`;
        else d.innerText = txt;
        chatBox.appendChild(d);
        chatBox.scrollTop = chatBox.scrollHeight;
        return id;
    }

    function clearChat() {
        const chatBox = document.getElementById('chat-box');
        if (chatBox) {
            chatBox.innerHTML = '';
            appendMsg("تم تصفير الذاكرة يا صفوان.", 'ai');
        }
    }

    // ==============================================
    // TIME NEXUS FUNCTIONS (مبسطة)
    // ==============================================

    function initTimeNexus() {
        // لا يوجد عنصر canvas في HTML الحالي، لذلك نتركه مبسطاً
        console.log('Time Nexus مبسطة في هذه النسخة');
    }

    // ==============================================
    // GLOBAL FUNCTION EXPORTS
    // ==============================================

    // تعريف الدوال العاملة في النطاق العالمي
    window.switchScreen = switchScreen;
    window.openConceptPanel = openConceptPanel;
    window.closePanel = closePanel;
    window.toggleTip = toggleTip;
    window.toggleDetails = toggleDetails;
    window.rateConcept = rateConcept;
    window.showResetConfirm = showResetConfirm;
    window.openConceptForReview = openConceptForReview;
    window.elitePrevCard = elitePrevCard;
    window.eliteNextCard = eliteNextCard;
    window.eliteRateCard = eliteRateCard;
    window.sendMsg = sendMsg;
    window.clearChat = clearChat;

    // تهيئة إضافية للتأكد من عمل كل شيء
    setTimeout(() => {
        // التأكد من تطبيق التفضيلات
        applyPreferences();
        
        // التأكد من ظهور العناصر بشكل صحيح
        renderRadarNodes();
        updateUI();
        
        // إضافة فئة للهواتف
        if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
            document.body.classList.add('mobile-device');
        }
        
        console.log('📍 رادار العقل - تم التهيئة الكاملة');
    }, 500);

    // تحسينات إضافية للأداء
    window.addEventListener('resize', function() {
        // إعادة حساب حجم الرادار
        renderRadarNodes();
    });

    window.addEventListener('load', function() {
        // تحسين الأداء على الهواتف
        if ('ontouchstart' in window) {
            document.body.classList.add('touch-device');
        }
        
        // تهيئة التطبيقات
        setTimeout(() => {
            renderRadarNodes();
            updateUI();
        }, 100);
    });

    // تحسين استجابة اللمس
    document.addEventListener('touchmove', function(e) {
        // منع التمرير الافتراضي للعناصر القابلة للنقر
        if (e.target.classList.contains('node') || 
            e.target.classList.contains('nav-btn') || 
            e.target.classList.contains('nav-item') ||
            e.target.classList.contains('rating-btn') ||
            e.target.classList.contains('control-btn')) {
            e.preventDefault();
        }
    }, { passive: false });

    // دالة مساعدة لتحميل الصفحة بسلاسة
    function loadPageSmoothly(pageId) {
        const page = document.getElementById(pageId);
        if (page) {
            page.style.opacity = '0';
            page.style.transform = 'translateY(20px)';
            page.classList.add('active');
            
            setTimeout(() => {
                page.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                page.style.opacity = '1';
                page.style.transform = 'translateY(0)';
            }, 10);
        }
    }

    // تحسين تجربة المستخدم على الشاشات الصغيرة
    function optimizeForSmallScreens() {
        const isSmallScreen = window.innerWidth <= 480;
        if (isSmallScreen) {
            // تعديلات للشاشات الصغيرة
            document.body.classList.add('small-screen');
            
            // تحسين حجم الخط
            if (userState.preferences.fontSize === 'small') {
                document.body.classList.add('font-xsmall');
            }
        } else {
            document.body.classList.remove('small-screen', 'font-xsmall');
        }
    }

    // استدعاء التحسينات عند تغيير حجم الشاشة
    window.addEventListener('resize', optimizeForSmallScreens);
    
    // تشغيل التحسينات عند التحميل
    optimizeForSmallScreens();

    // تحسينات نهائية
    document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'visible') {
            // تحديث البيانات عند العودة للتطبيق
            updateUI();
            updateEliteUI();
        }
    });

