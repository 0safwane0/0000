<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#00080f">
    <title>رادار العقل - نظام التعلم الاستراتيجي</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        :root {
            --neon-cyan: #00ffcc;
            --neon-red: #ff3366;
            --neon-blue: #3366ff;
            --neon-green: #33ff66;
            --neon-yellow: #ffcc00;
            --neon-purple: #cc33ff;
            --bg-dark: #00080f;
            --bg-light: #f5f9ff;
            --bg-card-dark: rgba(1, 15, 25, 0.95);
            --bg-card-light: rgba(255, 255, 255, 0.98);
            --text-primary-dark: #ffffff;
            --text-secondary-dark: rgba(255, 255, 255, 0.8);
            --text-primary-light: #000814;
            --text-secondary-light: rgba(0, 8, 20, 0.7);
            --border-light: rgba(0, 255, 204, 0.2);
            --shadow-glow: 0 0 20px rgba(0, 255, 204, 0.2);
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 16px;
            --transition-fast: 150ms ease;
            --transition-medium: 250ms ease;
            --elite-dark: #020617;
            --elite-blue: #3b82f6;
            --elite-green: #34d399;
            --elite-yellow: #fbbf24;
            --elite-red: #f87171;
            --elite-purple: #8b5cf6;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background: var(--bg-dark);
            color: var(--text-primary-dark);
            line-height: 1.4;
            min-height: 100vh;
            overflow-x: hidden;
            font-size: 14px;
            transition: background var(--transition-medium), color var(--transition-medium);
        }

        body.light-mode {
            background: var(--bg-light);
            color: var(--text-primary-light);
        }

        .app-container {
            max-width: 100%;
            margin: 0 auto;
            padding: 0 12px;
            width: 100%;
        }

        .screen {
            display: none;
            min-height: calc(100vh - 140px);
            padding-top: 70px;
            padding-bottom: 80px;
            overflow-y: auto;
        }

        .screen.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        h1 { font-size: 1.5rem; font-weight: 800; }
        h2 { font-size: 1.3rem; font-weight: 700; }
        h3 { font-size: 1.1rem; font-weight: 700; }
        h4 { font-size: 1rem; font-weight: 600; }
        p { font-size: 0.85rem; margin-bottom: 0.75rem; }
        .text-small { font-size: 0.8rem; }
        .text-xsmall { font-size: 0.75rem; }

        /* ===== HEADER ===== */
        .top-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(0, 8, 15, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-light);
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            height: 60px;
        }

        .light-mode .top-header {
            background: rgba(245, 249, 255, 0.95);
        }

        .app-title {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .app-name {
            font-size: 1rem;
            font-weight: 900;
            color: var(--neon-cyan);
            letter-spacing: 0.5px;
        }

        .app-subtitle {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 1px;
        }

        .light-mode .app-subtitle {
            color: rgba(0, 8, 20, 0.5);
        }

        /* ===== BOTTOM NAV ===== */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 8, 15, 0.95);
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--border-light);
            padding: 10px 16px;
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 1000;
            height: 70px;
        }

        .light-mode .bottom-nav {
            background: rgba(245, 249, 255, 0.95);
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 8px;
            border: none;
            background: transparent;
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.7rem;
            font-weight: 600;
            cursor: pointer;
            min-width: 60px;
            border-radius: var(--radius-sm);
            transition: all var(--transition-fast);
            position: relative;
        }

        .light-mode .nav-item {
            color: rgba(0, 8, 20, 0.6);
        }

        .nav-item.active {
            color: var(--neon-cyan);
            background: rgba(0, 255, 204, 0.1);
            transform: translateY(-2px);
        }

        .nav-icon {
            font-size: 1.2rem;
        }

        .nav-badge {
            position: absolute;
            top: 0;
            left: 60%;
            background: var(--neon-red);
            color: white;
            font-size: 0.6rem;
            font-weight: 900;
            min-width: 18px;
            height: 18px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ===== RADAR SCREEN ===== */
        .radar-container {
            position: relative;
            width: 100%;
            height: 55vh;
            min-height: 300px;
            max-height: 450px;
            background: radial-gradient(circle at center, rgba(0, 26, 42, 0.8) 0%, transparent 70%);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-light);
            overflow: hidden;
            margin: 12px 0 20px 0;
        }

        .light-mode .radar-container {
            background: radial-gradient(circle at center, rgba(230, 244, 255, 0.9) 0%, transparent 70%);
        }

        .radar-circle {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            border: 1px solid rgba(0, 255, 204, 0.1);
            border-radius: 50%;
            pointer-events: none;
        }

        .radar-circle:nth-child(1) { width: 30%; height: 30%; }
        .radar-circle:nth-child(2) { width: 60%; height: 60%; }
        .radar-circle:nth-child(3) { width: 90%; height: 90%; }

        /* ===== NODES ===== */
        .node {
            position: absolute;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            z-index: 50;
            transition: all var(--transition-medium);
            display: flex;
            align-items: center;
            justify-content: center;
            touch-action: manipulation;
            user-select: none;
            border: 2px solid;
            font-size: 0.7rem;
            font-weight: 700;
        }

        .node:hover {
            transform: scale(1.3);
            z-index: 100;
        }

        .node.active {
            transform: scale(1.5);
            z-index: 200;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 20px currentColor; }
            50% { box-shadow: 0 0 40px currentColor; }
        }

        .node-new {
            background: var(--neon-purple);
            border-color: var(--neon-purple);
            color: white;
            box-shadow: 0 0 15px var(--neon-purple);
        }

        .node-easy {
            background: var(--neon-green);
            border-color: var(--neon-green);
            color: #000;
            box-shadow: 0 0 15px var(--neon-green);
        }

        .node-medium {
            background: var(--neon-yellow);
            border-color: var(--neon-yellow);
            color: #000;
            box-shadow: 0 0 15px var(--neon-yellow);
        }

        .node-hard {
            background: var(--neon-red);
            border-color: var(--neon-red);
            color: white;
            box-shadow: 0 0 15px var(--neon-red);
        }

        .node-mastered {
            background: var(--neon-cyan);
            border-color: var(--neon-cyan);
            color: #000;
            box-shadow: 0 0 15px var(--neon-cyan);
        }

        .node-due {
            background: var(--neon-red);
            border-color: var(--neon-red);
            color: white;
            box-shadow: 0 0 20px var(--neon-red);
            animation: duePulse 2s infinite;
        }

        @keyframes duePulse {
            0%, 100% { transform: scale(1.1); }
            50% { transform: scale(1.3); }
        }

        .node-label {
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.65rem;
            font-weight: 700;
            white-space: nowrap;
            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
            opacity: 0.8;
        }

        /* ===== STATS ===== */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin: 20px 0;
        }

        .stat-card {
            background: rgba(0, 255, 204, 0.05);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 15px;
            text-align: center;
        }

        .light-mode .stat-card {
            background: rgba(0, 150, 150, 0.05);
        }

        .stat-value {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--neon-cyan);
            line-height: 1;
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.7);
        }

        .light-mode .stat-label {
            color: rgba(0, 8, 20, 0.6);
        }

        /* ===== CONCEPT PANEL ===== */
        .panel-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 5, 10, 0.9);
            backdrop-filter: blur(5px);
            z-index: 2000;
            opacity: 0;
            visibility: hidden;
            transition: all var(--transition-medium);
        }

        .light-mode .panel-overlay {
            background: rgba(0, 20, 40, 0.7);
        }

        .panel-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .concept-panel {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            width: 95%;
            max-width: 450px;
            max-height: 85vh;
            background: var(--bg-card-dark);
            backdrop-filter: blur(20px);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-light);
            border-top: 4px solid var(--neon-cyan);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            z-index: 2001;
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transition: all var(--transition-medium);
        }

        .light-mode .concept-panel {
            background: var(--bg-card-light);
            border-color: rgba(0, 150, 150, 0.3);
        }

        .concept-panel.active {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, -50%) scale(1);
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            border-bottom: 1px solid var(--border-light);
            background: linear-gradient(90deg, rgba(0, 255, 204, 0.1) 0%, transparent 100%);
        }

        .panel-title {
            flex: 1;
            padding-right: 10px;
        }

        .panel-category {
            font-size: 0.7rem;
            color: var(--neon-cyan);
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .panel-close {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1rem;
            transition: all var(--transition-fast);
        }

        .panel-close:hover {
            background: var(--neon-red);
            transform: rotate(90deg);
        }

        .panel-content {
            padding: 16px;
            overflow-y: auto;
            max-height: calc(85vh - 200px);
        }

        .panel-description {
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border-light);
            line-height: 1.6;
            font-size: 0.85rem;
        }

        .light-mode .panel-description {
            color: var(--text-secondary-light);
        }

        /* ===== TIP & DETAILS ===== */
        .tip-section, .details-section {
            margin-top: 16px;
            padding: 14px;
            border-radius: var(--radius-md);
            background: rgba(0, 255, 204, 0.05);
            border: 1px solid rgba(0, 255, 204, 0.2);
            transition: all var(--transition-medium);
            max-height: 0;
            overflow: hidden;
            opacity: 0;
        }

        .tip-section.active, .details-section.active {
            max-height: 400px;
            opacity: 1;
            margin-top: 16px;
        }

        .light-mode .tip-section,
        .light-mode .details-section {
            background: rgba(0, 200, 200, 0.05);
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
            color: var(--neon-cyan);
            font-weight: 700;
            font-size: 0.9rem;
        }

        .section-content {
            font-size: 0.8rem;
            line-height: 1.5;
            color: rgba(255, 255, 255, 0.9);
        }

        .light-mode .section-content {
            color: rgba(0, 8, 20, 0.8);
        }

        .details-list {
            list-style: none;
            margin-top: 8px;
        }

        .details-list li {
            position: relative;
            padding-right: 16px;
            margin-bottom: 6px;
            font-size: 0.8rem;
            line-height: 1.4;
        }

        .details-list li::before {
            content: "•";
            position: absolute;
            right: 0;
            color: var(--neon-cyan);
        }

        .details-list.public li::before {
            color: var(--neon-blue);
        }

        .details-list.secret li::before {
            color: var(--neon-red);
        }

        /* ===== RATING BUTTONS ===== */
        .rating-buttons {
            display: flex;
            gap: 8px;
            margin: 20px 0;
        }

        .rating-btn {
            flex: 1;
            padding: 12px 8px;
            border-radius: var(--radius-md);
            border: none;
            font-family: 'Tajawal', sans-serif;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all var(--transition-fast);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .rating-btn:hover {
            transform: translateY(-2px);
        }

        .btn-hard {
            background: var(--neon-red);
            color: white;
        }

        .btn-medium {
            background: var(--neon-yellow);
            color: #000;
        }

        .btn-easy {
            background: var(--neon-green);
            color: #000;
        }

        /* ===== CONTROL BUTTONS ===== */
        .panel-controls {
            display: flex;
            gap: 10px;
            padding: 16px;
            border-top: 1px solid var(--border-light);
            background: rgba(0, 0, 0, 0.3);
        }

        .light-mode .panel-controls {
            background: rgba(0, 0, 0, 0.05);
        }

        .control-btn {
            flex: 1;
            padding: 14px 10px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-light);
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary-dark);
            font-family: 'Tajawal', sans-serif;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all var(--transition-fast);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 46px;
        }

        .light-mode .control-btn {
            background: rgba(0, 0, 0, 0.05);
            color: var(--text-primary-light);
        }

        .control-btn:hover {
            background: rgba(0, 255, 204, 0.1);
            border-color: var(--neon-cyan);
        }

        .control-btn.active {
            background: var(--neon-cyan);
            color: #000;
            border-color: var(--neon-cyan);
            box-shadow: var(--shadow-glow);
        }

        /* ===== SETTINGS ===== */
        .settings-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 20px;
        }

        .setting-item {
            background: rgba(0, 255, 204, 0.05);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all var(--transition-fast);
        }

        .light-mode .setting-item {
            background: rgba(0, 200, 200, 0.05);
        }

        .setting-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .setting-icon {
            font-size: 1.2rem;
            color: var(--neon-cyan);
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 255, 204, 0.1);
            border-radius: 50%;
        }

        .setting-title {
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 2px;
        }

        .setting-desc {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.6);
        }

        .light-mode .setting-desc {
            color: rgba(0, 8, 20, 0.5);
        }

        /* ===== TOGGLE SWITCH ===== */
        .switch {
            position: relative;
            display: inline-block;
            width: 54px;
            height: 28px;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(255, 255, 255, 0.1);
            transition: var(--transition-medium);
            border-radius: 34px;
            border: 1px solid var(--border-light);
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            right: 4px;
            bottom: 3px;
            background-color: white;
            transition: var(--transition-medium);
            border-radius: 50%;
        }

        input:checked + .slider {
            background-color: var(--neon-cyan);
        }

        input:checked + .slider:before {
            transform: translateX(-26px);
        }

        /* ===== ELITE PRO APP STYLES ===== */
        .elite-header {
            background: rgba(2, 6, 23, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 12px 16px;
            text-align: center;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
        }

        .elite-header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }

        .elite-supervisor {
            font-size: 11px;
            color: #94a3b8;
            white-space: nowrap;
        }

        .elite-app-title {
            font-size: 13px;
            font-weight: 900;
            color: var(--neon-cyan);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .elite-stats-container {
            padding: 16px;
            padding-top: 80px;
        }

        .elite-stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            max-width: 600px;
            margin: 0 auto;
        }

        .elite-stat-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 16px;
            padding: 14px 10px;
            text-align: center;
            backdrop-filter: blur(10px);
        }

        .elite-stat-label {
            font-size: 10px;
            color: #94a3b8;
            font-weight: 700;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .elite-stat-value {
            font-size: 18px;
            font-weight: 900;
            line-height: 1.2;
        }

        .elite-card-section {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 16px;
            position: relative;
            min-height: 0;
            overflow: hidden;
        }

        .elite-card-wrapper {
            width: 100%;
            max-width: 500px;
            height: 320px;
            perspective: 1000px;
            margin: 20px auto;
        }

        .elite-card-inner {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            border-radius: 24px;
            cursor: pointer;
        }

        .elite-card-inner.flipped {
            transform: rotateY(180deg);
        }

        .elite-card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            border-radius: 24px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .elite-card-front {
            background: linear-gradient(145deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.9));
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .elite-card-back {
            background: linear-gradient(145deg, rgba(30, 58, 138, 0.8), rgba(23, 23, 23, 0.9));
            transform: rotateY(180deg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .elite-term-title {
            font-size: 24px;
            font-weight: 800;
            text-align: center;
            margin-bottom: 16px;
            color: #f8fafc;
            line-height: 1.3;
            padding: 0 20px;
        }

        .elite-term-description {
            font-size: 16px;
            line-height: 1.6;
