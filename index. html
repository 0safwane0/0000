    function loadUserState() {
        const saved = localStorage.getItem('mindRadar_userState');
        if (saved) {
            userState = JSON.parse(saved);
        }
    }

    function saveUserState() {
        userState.stats.lastActive = new Date().toISOString();
        localStorage.setItem('mindRadar_userState', JSON.stringify(userState));
    }

    function updateStreak() {
        const today = new Date().toDateString();
        const lastActive = userState.stats.lastActive ? new Date(userState.stats.lastActive).toDateString() : null;
        
        if (!lastActive || lastActive !== today) {
            const yesterday = new Date();
            yesterday.setDate(yesterday.getDate() - 1);
            const yesterdayStr = yesterday.toDateString();
            
            if (lastActive === yesterdayStr) {
                userState.stats.streak++;
            } else if (!lastActive || lastActive !== yesterdayStr) {
                userState.stats.streak = 1;
            }
            
            saveUserState();
        }
    }

    function applyPreferences() {
        // تطبيق الوضع الداكن/الفاتح
        if (userState.preferences.darkMode) {
            document.body.classList.remove('light-mode');
            if (document.getElementById('theme-toggle')) {
                document.getElementById('theme-toggle').checked = false;
            }
        } else {
            document.body.classList.add('light-mode');
            if (document.getElementById('theme-toggle')) {
                document.getElementById('theme-toggle').checked = true;
            }
        }
        
        // تطبيق حجم الخط
        document.body.classList.remove('font-small', 'font-medium', 'font-large');
        document.body.classList.add(`font-${userState.preferences.fontSize}`);
        
        if (document.getElementById('font-size-select')) {
            document.getElementById('font-size-select').value = userState.preferences.fontSize;
        }
        
        if (document.getElementById('sound-toggle')) {
            document.getElementById('sound-toggle').checked = userState.preferences.sound;
        }
        
        if (document.getElementById('haptic-toggle')) {
            document.getElementById('haptic-toggle').checked = userState.preferences.haptic;
        }
        
        saveUserState();
    }

    function setupEventListeners() {
        const overlay = document.getElementById('panel-overlay');
        if (overlay) {
            overlay.addEventListener('click', closePanel);
        }
        
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
            themeToggle.addEventListener('change', function() {
                userState.preferences.darkMode = !this.checked;
                applyPreferences();
            });
        }
        
        const soundToggle = document.getElementById('sound-toggle');
        if (soundToggle) {
            soundToggle.addEventListener('change', function() {
                userState.preferences.sound = this.checked;
                saveUserState();
            });
        }
        
        const hapticToggle = document.getElementById('haptic-toggle');
        if (hapticToggle) {
            hapticToggle.addEventListener('change', function() {
                userState.preferences.haptic = this.checked;
                saveUserState();
            });
        }
        
        const fontSizeSelect = document.getElementById('font-size-select');
        if (fontSizeSelect) {
            fontSizeSelect.addEventListener('change', function() {
                userState.preferences.fontSize = this.value;
                applyPreferences();
                saveUserState();
            });
        }
        
        // إضافة حدث النقر للبطاقة في تطبيق النخبة
        const eliteCard = document.getElementById('elite-main-card');
        if (eliteCard) {
            eliteCard.addEventListener('click', function() {
                eliteCard.classList.toggle('flipped');
                playSound('toggle');
                vibrate(30);
            });
            
            eliteCard.addEventListener('touchstart', function(e) {
                if (e.touches.length === 1) {
                    this.classList.toggle('flipped');
                    playSound('toggle');
                    vibrate(30);
                }
            }, { passive: true });
        }
        
        // تحسين تجربة اللمس
        document.addEventListener('touchmove', function(e) {
            if (e.scale !== 1) {
                e.preventDefault();
            }
        }, { passive: false });
        
        // منع التكبير باللمس المزدوج
        let lastTouchEnd = 0;
        document.addEventListener('touchend', function(e) {
            const now = Date.now();
            if (now - lastTouchEnd <= 300) {
                e.preventDefault();
            }
            lastTouchEnd = now;
        }, false);
    }
