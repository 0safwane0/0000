                alert('مرحباً بك في رادار العقل!\nانقر على النقاط لاستكشاف المفاهيم الاستراتيجية.');
                localStorage.setItem('mindRadar_welcomed', 'true');
            }, 500);
        }
    }

    function loadUserState() {
        const saved = localStorage.getItem('mindRadar_userState');
        if (saved) {
            userState = JSON.parse(saved);
        }
    }

    function saveUserState() {
        userState.stats.lastActive = new Date().toISOString();
        localStorage.setItem('mindRadar_userState', JSON.stringify(userState));
    }

    // ==============================================
    // RADAAR AL-AQL FUNCTIONS
    // ==============================================

    function renderRadarNodes() {
        const container = document.getElementById('nodes-container');
        container.innerHTML = '';
        
        STRATEGIC_DATA.forEach(data => {
            const node = document.createElement('div');
            node.className = 'node';
            
            const progress = userState.progress[data.id];
            if (!progress) {
                node.classList.add('node-new');
            } else if (progress.difficulty === 'easy') {
                node.classList.add('node-easy');
            } else if (progress.difficulty === 'medium') {
                node.classList.add('node-medium');
            } else if (progress.difficulty === 'hard') {
                node.classList.add('node-hard');
            } else {
                node.classList.add('node-new');
            }
            
            if (progress && isDue(progress)) {
                node.classList.add('node-due');
            }
            
            node.style.left = data.x + '%';
            node.style.top = data.y + '%';
            node.textContent = data.id.replace('T', '');
            
            const label = document.createElement('div');
            label.className = 'node-label';
            label.textContent = data.title.split(' ')[0];
            node.appendChild(label);
            
            node.addEventListener('click', function(e) {
                e.stopPropagation();
                openConceptPanel(data, node);
            });
            
            container.appendChild(node);
        });
    }

    function isDue(progress) {
        if (!progress.nextReview) return true;
        const now = new Date();
        const dueDate = new Date(progress.nextReview);
        return dueDate <= now;
    }

    function openConceptPanel(data, nodeElement) {
        currentConcept = data;
        
        document.getElementById('concept-title').textContent = data.title;
        document.getElementById('concept-category').textContent = data.category;
        document.getElementById('concept-description').textContent = data.description;
        document.getElementById('tip-content').textContent = data.hint;
        
        const publicList = document.getElementById('public-goals');
        const secretList = document.getElementById('secret-goals');
        
        publicList.innerHTML = data.public.map(goal => `<li>${goal}</li>`).join('');
        secretList.innerHTML = data.secret.map(goal => `<li>${goal}</li>`).join('');
        
        document.getElementById('tip-section').classList.remove('active');
        document.getElementById('details-section').classList.remove('active');
        document.getElementById('tip-btn').classList.remove('active');
        document.getElementById('details-btn').classList.remove('active');
        
        document.getElementById('panel-overlay').classList.add('active');
        document.getElementById('concept-panel').classList.add('active');
        
        playSound('open');
    }

    function closePanel() {
        document.getElementById('panel-overlay').classList.remove('active');
        document.getElementById('concept-panel').classList.remove('active');
        currentConcept = null;
        playSound('close');
    }

    function toggleTip() {
        const tipSection = document.getElementById('tip-section');
        const tipBtn = document.getElementById('tip-btn');
        
        tipSection.classList.toggle('active');
        tipBtn.classList.toggle('active');
        
        playSound('toggle');
    }

    function toggleDetails() {
        const detailsSection = document.getElementById('details-section');
        const detailsBtn = document.getElementById('details-btn');
        
        detailsSection.classList.toggle('active');
        detailsBtn.classList.toggle('active');
        
        playSound('toggle');
    }

    function rateConcept(difficulty) {
        if (!currentConcept) return;
        
        const now = new Date();
        const progress = userState.progress[currentConcept.id] || {
            ease: 2.5,
            interval: 0,
            reviewCount: 0,
            difficulty: 'new'
        };
        
        progress.lastSeen = now.toISOString();
        progress.reviewCount++;
        progress.difficulty = difficulty;
        
        let intervalDays;
        switch(difficulty) {
            case 'easy':
                intervalDays = progress.interval * 2.5 || 7;
                progress.ease = Math.min(progress.ease + 0.1, 3.0);
                break;
            case 'medium':
                intervalDays = progress.interval * 1.5 || 3;
                break;
            case 'hard':
                intervalDays = 1;
                progress.ease = Math.max(progress.ease - 0.2, 1.3);
                break;
        }
        
        const nextReview = new Date(now);
        nextReview.setDate(nextReview.getDate() + intervalDays);
        progress.nextReview = nextReview.toISOString();
        progress.interval = intervalDays;
        
        userState.progress[currentConcept.id] = progress;
        saveUserState();
        
        updateUI();
        renderRadarNodes();
        
        const messages = {
            easy: 'ممتاز! لقد أتقنت هذا المفهوم.',
            medium: 'جيد! سأذكرك بهذا المفهوم لاحقاً.',
            hard: 'لا بأس! سأظهره لك مجدداً قريباً.'
        };
        
        setTimeout(() => {
            alert(messages[difficulty]);
            closePanel();
        }, 300);
    }

    function updateUI() {
        const total = STRATEGIC_DATA.length;
        const mastered = Object.values(userState.progress).filter(p => p.difficulty === 'easy').length;
        const due = Object.values(userState.progress).filter(p => isDue(p)).length;
        const streak = userState.stats.streak || 0;
        
        document.getElementById('total-concepts').textContent = total;
        document.getElementById('mastered-concepts').textContent = mastered;
        document.getElementById('due-concepts').textContent = due;
        document.getElementById('streak-days').textContent = streak;
        
        const badge = document.getElementById('review-badge');
        if (due > 0) {
            badge.textContent = due > 9 ? '9+' : due;
            badge.style.display = 'flex';
        } else {
            badge.style.display = 'none';
        }
        
        updateReviewScreen();
    }

    function updateReviewScreen() {
        const reviewContent = document.getElementById('review-content');
        const dueConcepts = STRATEGIC_DATA.filter(data => {
            const progress = userState.progress[data.id];
            return progress && isDue(progress);
        });
        
        if (dueConcepts.length === 0) {
            reviewContent.innerHTML = `
                <div style="text-align: center; padding: 40px 20px;">
                    <div style="font-size: 3rem; margin-bottom: 20px; opacity: 0.5;">🎉</div>
                    <h3>لا توجد مفاهيم للمراجعة</h3>
                    <p style="color: rgba(255,255,255,0.7); margin: 10px 0 20px 0;">جميع المفاهيم محدثة!</p>
                    <button onclick="switchScreen('radar')" style="background: var(--neon-cyan); color: #000; border: none; padding: 12px 24px; border-radius: var(--radius-md); font-weight: bold; cursor: pointer;">
                        العودة للرادار
                    </button>
                </div>
            `;
            return;
        }
        
        let html = '<div style="padding: 10px;">';
        html += '<h3 style="margin-bottom: 20px;">المفاهيم التي تحتاج مراجعة</h3>';
        
        dueConcepts.forEach(concept => {
            const progress = userState.progress[concept.id];
            html += `
                <div style="background: rgba(0,255,204,0.05); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 15px; margin-bottom: 10px;">
                    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;">
                        <h4 style="flex: 1; padding-right: 10px;">${concept.title}</h4>
                        <span style="background: ${getDifficultyColor(progress.difficulty)}; color: ${progress.difficulty === 'medium' ? '#000' : '#fff'}; padding: 4px 10px; border-radius: 12px; font-size: 0.8rem; font-weight: bold;">
                            ${getDifficultyText(progress.difficulty)}
                        </span>
                    </div>
                    <p style="font-size: 0.85rem; color: rgba(255,255,255,0.8); margin-bottom: 15px;">${concept.description.substring(0, 80)}...</p>
                    <button onclick="openConceptForReview('${concept.id}')" style="background: var(--neon-cyan); color: #000; border: none; padding: 8px 16px; border-radius: var(--radius-sm); font-weight: bold; cursor: pointer; width: 100%;">
                        مراجعة المفهوم
                    </button>
                </div>
            `;
        });
        
        html += '</div>';
        reviewContent.innerHTML = html;
    }

    function getDifficultyColor(difficulty) {
        switch(difficulty) {
            case 'easy': return 'var(--neon-green)';
            case 'medium': return 'var(--neon-yellow)';
            case 'hard': return 'var(--neon-red)';
            default: return 'var(--neon-purple)';
        }
    }

    function getDifficultyText(difficulty) {
        switch(difficulty) {
            case 'easy': return 'سهل';
            case 'medium': return 'متوسط';
            case 'hard': return 'صعب';
            default: return 'جديد';
        }
    }

    function openConceptForReview(conceptId) {
        const concept = STRATEGIC_DATA.find(c => c.id === conceptId);
        const node = document.querySelector(`.node[style*="${concept.x}%"]`);
        if (concept && node) {
            openConceptPanel(concept, node);
        }
    }

    function switchScreen(screenName) {
        document.querySelectorAll('.screen').forEach(screen => {
            screen.classList.remove('active');
        });
        
        document.querySelectorAll('.nav-item').forEach(item => {
            item.classList.remove('active');
        });
        
        document.getElementById(`${screenName}-screen`).classList.add('active');
        
        const navButton = document.querySelector(`.nav-item[onclick*="${screenName}"]`);
        if (navButton) {
            navButton.classList.add('active');
        }
        
        if (screenName === 'elite') {
            updateEliteUI();
        }
        
        playSound('switch');
    }

    function setupEventListeners() {
        document.getElementById('panel-overlay').addEventListener('click', closePanel);
        
        document.getElementById('theme-toggle').addEventListener('change', function() {
            userState.preferences.darkMode = !this.checked;
            applyPreferences();
        });
        
        document.getElementById('sound-toggle').addEventListener('change', function() {
            userState.preferences.sound = this.checked;
            saveUserState();
        });
        
        document.getElementById('haptic-toggle').addEventListener('change', function() {
            userState.preferences.haptic = this.checked;
            saveUserState();
        });
        
        document.getElementById('font-size-select').addEventListener('change', function() {
            userState.preferences.fontSize = this.value;
            applyPreferences();
            saveUserState();
        });
        
        // إضافة حدث النقر للبطاقة في تطبيق النخبة
        const eliteCard = document.getElementById('elite-main-card');
        if (eliteCard) {
            eliteCard.addEventListener('click', function() {
                eliteCard.classList.toggle('flipped');
                playSound(300, 150);
                vibrate(30);
            });
        }
    }
        function applyPreferences() {
            if (userState.preferences.darkMode) {
                document.body.classList.remove('light-mode');
                document.getElementById('theme-toggle').checked = false;
            } else {
                document.body.classList.add('light-mode');
                document.getElementById('theme-toggle').checked = true;
            }
            
            // تطبيق حجم الخط
            document.body.classList.remove('font-small', 'font-medium', 'font-large');
            document.body.classList.add(`font-${userState.preferences.fontSize}`);
            
            document.getElementById('font-size-select').value = userState.preferences.fontSize;
            document.getElementById('sound-toggle').checked = userState.preferences.sound;
            document.getElementById('haptic-toggle').checked = userState.preferences.haptic;
            
            saveUserState();
        }

        function playSound(type) {
            if (!userState.preferences.sound) return;
            
            try {
                if (!audioContext) {
                    audioContext = new (window.AudioContext || window.webkitAudioContext)();
                }
                
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                const frequencies = {
                    open: 800,
                    close: 400,
                    toggle: 600,
                    switch: 500
                };
                
                oscillator.frequency.setValueAtTime(frequencies[type] || 440, audioContext.currentTime);
                oscillator.type = 'sine';
                gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);
                
                oscillator.start();
                oscillator.stop(audioContext.currentTime + 0.1);
                
                if (userState.preferences.haptic && 'vibrate' in navigator) {
                    navigator.vibrate(50);
                }
            } catch(e) {
                console.log('لا يمكن تشغيل الصوت');
            }
        }

        function showResetConfirm() {
            if (confirm('⚠️ هل أنت متأكد من إعادة التعيين؟ سيتم حذف جميع بياناتك.')) {
                localStorage.clear();
                alert('تم إعادة التعيين. سيتم إعادة تحميل الصفحة.');
                location.reload();
            }
        }

        // ==============================================
        // ELITE PRO FUNCTIONS
        // ==============================================

        function initEliteApp() {
            const saved = localStorage.getItem('elite_pro_data');
            if (saved) {
                try {
                    eliteState = JSON.parse(saved);
                } catch (e) {
                    console.log('خطأ في تحميل بيانات النخبة PRO');
                }
            }
            updateEliteUI();
        }

        function saveEliteData() {
            localStorage.setItem('elite_pro_data', JSON.stringify(eliteState));
        }

        function updateEliteUI() {
            const card = ELITE_APP_DATA[eliteState.currentCardIndex];
            
            if (!card) return;
            
            document.getElementById('elite-c-title').textContent = card.term;
            document.getElementById('elite-c-desc').textContent = card.definition;
            document.getElementById('elite-c-id').textContent = eliteState.currentCardIndex + 1;
            
            const percentage = Math.round((eliteState.reviewedCards / ELITE_APP_DATA.length) * 100);
            document.getElementById('elite-p-val').textContent = percentage + '%';
            document.getElementById('elite-s-val').textContent = eliteState.score;
            document.getElementById('elite-r-val').textContent = ELITE_APP_DATA.length - eliteState.reviewedCards;
            
            updateEliteLevel();
        }

        function updateEliteLevel() {
            let level = "مبتدئ";
            let color = "#f87171";
            
            if (eliteState.score >= 1000) {
                level = "خبير";
                color = "#8b5cf6";
            } else if (eliteState.score >= 500) {
                level = "متقدم";
                color = "#3b82f6";
            } else if (eliteState.score >= 200) {
                level = "متوسط";
                color = "#34d399";
            } else if (eliteState.score >= 50) {
                level = "مبتدئ";
                color = "#fbbf24";
            }
            
            document.getElementById('elite-level-val').textContent = level;
            document.getElementById('elite-level-val').style.color = color;
        }

        function elitePrevCard() {
            eliteState.currentCardIndex--;
            if (eliteState.currentCardIndex < 0) {
                eliteState.currentCardIndex = ELITE_APP_DATA.length - 1;
            }
            
            document.getElementById('elite-main-card').classList.remove('flipped');
            updateEliteUI();
            
            playSound(200, 100);
            vibrate(20);
        }

        function eliteNextCard() {
            eliteState.currentCardIndex++;
            if (eliteState.currentCardIndex >= ELITE_APP_DATA.length) {
                eliteState.currentCardIndex = 0;
            }
            
            document.getElementById('elite-main-card').classList.remove('flipped');
            updateEliteUI();
            
            playSound(250, 100);
            vibrate(20);
        }

        function eliteRateCard(difficulty) {
            eliteState.difficultyStats[difficulty]++;
            
            let points = 0;
            let message = '';
            
            switch(difficulty) {
                case 'hard':
                    points = 5;
                    message = 'صعب! +5 نقاط';
                    break;
                case 'mid':
                    points = 15;
                    message = 'متوسط! +15 نقطة';
                    break;
                case 'easy':
                    points = 40;
                    message = 'سهل! +40 نقطة 🎉';
                    eliteState.reviewedCards++;
                    break;
            }
            
            eliteState.score += points;
            
            alert(message);
            
            playSound(difficulty === 'easy' ? 600 : 400, 300);
            vibrate(50);
            
            checkEliteAchievements();
            
            setTimeout(() => {
                eliteNextCard();
                saveEliteData();
            }, 300);
        }

        function checkEliteAchievements() {
            if (eliteState.reviewedCards >= 1 && !eliteState.achievements[0].unlocked) {
                unlockEliteAchievement(0);
            }
            
            if (eliteState.score >= 500 && !eliteState.achievements[2].unlocked) {
                unlockEliteAchievement(2);
            }
        }

        function unlockEliteAchievement(index) {
            if (eliteState.achievements[index].unlocked) return;
            
            eliteState.achievements[index].unlocked = true;
            eliteState.score += 100;
            
            alert(`🏆 إنجاز مفتوح: ${eliteState.achievements[index].name}!`);
            
            playSound(800, 1000);
            playSound(1000, 800);
            
            saveEliteData();
        }

        function vibrate(duration) {
            if (navigator.vibrate && userState.preferences.haptic) {
                try {
                    navigator.vibrate(duration);
                } catch (error) {}
            }
        }

        // تعريف الدوال العاملة
        window.switchScreen = switchScreen;
        window.openConceptPanel = openConceptPanel;
        window.closePanel = closePanel;
        window.toggleTip = toggleTip;
        window.toggleDetails = toggleDetails;
        window.rateConcept = rateConcept;
        window.showResetConfirm = showResetConfirm;
        window.openConceptForReview = openConceptForReview;
        window.elitePrevCard = elitePrevCard;
        window.eliteNextCard = eliteNextCard;
        window.eliteRateCard = eliteRateCard;
    </script>
